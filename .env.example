NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgres://shpitto:shpitto-local-only@localhost:5432/shpitto
BETTER_AUTH_SECRET=replace-me-with-a-long-random-development-secret
AUTH_TRUSTED_ORIGINS=http://localhost:3000
STORAGE_DRIVER=local
# Production only: set STORAGE_DRIVER=s3. R2 and AWS S3 use the same adapter.
# MinIO is a local contract-test target only; STORAGE_S3_FORCE_PATH_STYLE=true and HTTP is permitted outside production.
# Keep the bucket private; the application authorizes downloads and streams bytes.
# STORAGE_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_S3_REGION=auto
# STORAGE_S3_BUCKET=shpitto-media
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
# STORAGE_S3_FORCE_PATH_STYLE=false
GENERATION_DRIVER=mock
# Task orchestration defaults to the buyer-owned worker; no Trigger account is required.
TASK_RUNTIME=self_hosted
# Reserved for the optional integration. This build rejects TASK_RUNTIME=trigger
# until scoped executable task registration and deployment are verified.
# TRIGGER_PROJECT_REF=proj_...
# TRIGGER_SECRET_KEY=tr_...
MAIL_DRIVER=local
MAIL_SMTP_URL=smtp://localhost:1025
MAIL_HTTP_URL=http://localhost:8025
BILLING_WEBHOOK_SECRET=local-development-billing-webhook-secret
# Default billing remains offline. Stripe test billing requires all fields below,
# NODE_ENV=production and SHPTITTO_RUNTIME_PROFILE=acceptance on an isolated database.
BILLING_DRIVER=fixture
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PORTAL_CONFIGURATION_ID=bpc_...
# STRIPE_TEST_CATALOG_JSON=[]
# Set BILLING_WEBHOOK_SECRET to the test endpoint's whsec_... value.
# Keep subscription updates disabled and cancellation at period end with no proration.
ASSET_ROOT=./.data/assets
WORKER_HEALTH_URL=http://localhost:8080/healthz
# Isolated acceptance recovery monitoring runs in a separate process/service.
# Never share provider credentials with the monitor. The receiver is disabled by default.
# SHPITTO_RECOVERY_MONITOR_MODE=off
# SHPITTO_RECOVERY_MONITOR_WORKSPACE_ID=
# SHPITTO_RECOVERY_MONITOR_KEY=provider-sweep
# SHPITTO_RECOVERY_ALERT_URL=https://your-demo.example/api/internal/recovery-alerts
# SHPITTO_RECOVERY_ALERT_SECRET=
# Acceptance-only hosted owner/member bootstrap. Keep disabled outside a one-time
# acceptance seed and remove the secret after the seed completes.
# SHPITTO_ACCEPTANCE_BOOTSTRAP_ENABLED=off
# SHPITTO_ACCEPTANCE_BOOTSTRAP_SECRET=
