name = "shpitto-contact-email-worker"
main = "src/index.ts"
compatibility_date = "2026-05-18"
workers_dev = true

[vars]
CLOUDFLARE_EMAIL_ACCOUNT_ID = "REPLACE_WITH_EMAIL_ACCOUNT_ID"
CLOUDFLARE_EMAIL_FROM = "official@example.com"
CONTACT_EMAIL_BATCH_SIZE = "10"
SHPITTO_CONTACT_EMAIL_MAX_RETRIES = "3"

[triggers]
crons = ["*/1 * * * *"]

[[routes]]
pattern = "email.shpitto.com"
custom_domain = true

[[d1_databases]]
binding = "EMAIL_QUEUE_DB"
database_name = "shpitto-prod"
database_id = "REPLACE_WITH_D1_DATABASE_ID"
