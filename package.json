  "dependencies": {
    "@aws-sdk/client-s3": "3.1141.0",
    "@trigger.dev/sdk": "4.6.4",
    "better-auth": "1.7.6",
    "drizzle-orm": "0.45.3",
    "fumadocs-core": "16.15.14",
    "fumadocs-ui": "16.15.14",
    "next": "16.3.8",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-admin": "5.15.4",
    "react-dom": "19.3.0",
    "stripe": "22.6.2"
