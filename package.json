    "db:probe:generation-lifecycle": "node --experimental-strip-types scripts/probe-generation-lifecycle.ts",
    "db:probe:outbox-lease": "node --experimental-strip-types scripts/probe-outbox-lease.ts",
    "db:probe:assets": "node --experimental-strip-types scripts/probe-assets.ts",
    "db:probe:generation-races": "node --experimental-strip-types scripts/probe-generation-races.ts",
    "db:probe:worker-container": "node --experimental-strip-types scripts/probe-worker-container.ts",
