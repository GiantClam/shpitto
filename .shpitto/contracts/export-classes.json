{
  "schemaVersion": "1.0",
  "classes": {
    "customerRuntime": {
      "include": ["src", "content/docs", "skills", "deploy", "package.json", "pnpm-lock.yaml", "next.config.ts", "tsconfig.json"],
      "exclude": ["internal", "legacy", ".omx", ".git", "vendor", "node_modules", ".env*", "*.log"]
    },
    "buyerGuidance": {
      "include": ["docs/buyer", "content/docs"],
      "exclude": ["internal", "legacy", ".omx", ".git", "private", "secrets"]
    },
    "engineeringEvidence": {
      "include": ["internal", "openspec", ".omx/plans"],
      "exclude": ["customerRuntime", "buyerGuidance"]
    }
  },
  "validatorOwner": "release-engineering",
  "digestRule": "A candidate export is valid only when the trusted validator digest matches the reviewed source and lockfile digests."
}
