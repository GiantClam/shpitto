    "smoke:casux-fullflow:live": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/run-casux-fullflow-live.mts",
    "smoke:website-generation-mvp": "pnpm exec tsx scripts/website-generation-mvp.mts",
    "smoke:website-generation-mvp:casux": "pnpm exec tsx scripts/website-generation-mvp-casux.mts",
    "smoke:website-generation-mvp:vbuy:fullflow": "pnpm exec tsx scripts/website-generation-mvp-vbuy-fullflow.mts",
    "recover:website-generation-mvp": "pnpm exec tsx scripts/website-generation-mvp-recover.mts",
    "recover:website-generation-mvp:casux": "pnpm exec tsx scripts/website-generation-mvp-casux-recover.mts",
    "report:replay-generation-summary": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/replay-generation-summary.mts",
    "report:website-generation-v2-release-gate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/website-generation-v2-release-gate.mts",
    "report:website-generation-v2-cutover": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/website-generation-v2-cutover.mts",
    "test:hybrid-generation": "vitest run lib/skill-runtime/website-artifact-generator.test.ts lib/skill-runtime/website-type-selector.test.ts lib/skill-runtime/project-skill-loader.test.ts lib/skill-runtime/generation-worker-adapter.test.ts lib/skill-runtime/website-design-spec.test.ts lib/skill-runtime/skill-tool-executor.test.ts lib/agent/open-design-adoption-smoke.test.ts lib/agent/open-design-fullsite-live.test.ts --reporter=dot",
    "smoke:blog-runtime": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/blog-runtime-smoke.mts",
    "smoke:blog-runtime:wrangler": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/blog-runtime-wrangler-smoke.mts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.52",
    "@ai-sdk/react": "^3.0.160",
    "@industry/schema": "workspace:*",
