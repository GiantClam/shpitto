    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.4",
    "postcss": "^8",
    "tailwindcss": "^4.0.0-alpha.32",
    "typescript": "^5",
    "vite": "^7.3.2",
    "vitest": "^4.1.5"
  }
