{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shpitto source fulfillment entitlement",
  "type": "object",
  "required": ["kind", "buyerId", "githubIdentity", "orders", "releases", "updateSupportEndsAt"],
  "properties": {
    "kind": {"const": "source-license"},
    "buyerId": {"type": "string", "minLength": 1},
    "githubIdentity": {"type": "string", "minLength": 1},
    "orders": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/order"}},
    "releases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/release"}},
    "updateSupportEndsAt": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false,
  "$defs": {
    "release": {
      "type": "object",
      "required": ["version", "artifactSha256"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "artifactSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "order": {
      "type": "object",
      "required": ["id", "mode", "merchantId", "purchasedAt", "release"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "mode": {"enum": ["mock", "hosted"]},
        "merchantId": {"type": "string", "minLength": 1},
        "purchasedAt": {"type": "string", "format": "date-time"},
        "release": {"$ref": "#/$defs/release"}
      },
      "additionalProperties": false
    }
  }
}
